{
  "cli": {
    "version": ">= 16.31.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://iron-arc-backend-v2.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "89046456850-3sfgpbt5fg60uv1735p3lnedo5pvq8sd.apps.googleusercontent.com"
      }
    },
    "preview-optimized": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_DEV_CLIENT": "1",
        "EXPO_PUBLIC_BACKEND_URL": "https://iron-arc-backend-v2.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "89046456850-3sfgpbt5fg60uv1735p3lnedo5pvq8sd.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_NO_DEV_CLIENT": "1",
        "EXPO_PUBLIC_BACKEND_URL": "https://iron-arc-backend-v2.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "89046456850-3sfgpbt5fg60uv1735p3lnedo5pvq8sd.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
