{
  "expo": {
    "name": "Iron Arc",
    "slug": "GymTracker",
    "platforms": ["android"],
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ironarc",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111417",
    "primaryColor": "#22D47F",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pushpanathMr.GymTracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pushpanath_mr.GymTracker",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220"
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": { "light": "#5E6670", "dark": "#5E6670" },
              "windowBackground": { "light": "#191C1F", "dark": "#191C1F" },
              "textColorPrimary": { "light": "#E1E2E7", "dark": "#E1E2E7" },
              "textColorSecondary": { "light": "#BCCAC0", "dark": "#BCCAC0" }
            },
            "timePicker": {
              "background": { "light": "#191C1F", "dark": "#191C1F" },
              "headerBackground": { "light": "#323538", "dark": "#323538" },
              "numbersBackgroundColor": { "light": "#272A2E", "dark": "#272A2E" },
              "numbersSelectorColor": { "light": "#5E6670", "dark": "#5E6670" },
              "numbersTextColor": { "light": "#E1E2E7", "dark": "#E1E2E7" }
            }
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#22D47F"
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e3e6e45-1bd6-4622-9c2d-06908348104d"
      }
    }
  }
}
